{
  "name": "catnayplan",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests.mjs && node --test tests/v24-sync.test.mjs",
    "test:browser": "node tests/browser-check.cjs",
    "test:rules": "firebase emulators:exec --project demo-catnayplan --only firestore \"node --test tests/firestore-rules.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase": "12.4.0",
    "firebase-tools": "14.17.0",
    "playwright": "1.63.0"
  }
}
